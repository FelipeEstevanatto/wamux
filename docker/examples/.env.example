# Evolution GO - Configuração de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário

# ========================================
# COMPOSE (lidos pelo docker-compose.ghcr.yml)
# ========================================

# Porta no host onde a API/Manager ficam expostos (a app escuta 8080 dentro).
EVOGO_PORT=8081

# Tag da imagem: `dev` (branch develop), `0.8.1` (release) ou `latest`.
EVOGO_VERSION=dev

# ========================================
# CONFIGURAÇÕES OBRIGATÓRIAS
# ========================================

# Porta interna do servidor (deixe 8080 com o compose)
SERVER_PORT=8080

# Nome do cliente/instância
CLIENT_NAME=evolution

# Chave de API (OBRIGATÓRIO - Use uma chave forte e única)
GLOBAL_API_KEY=sua-chave-api-segura-aqui-uuid-recomendado

# ========================================
# BANCO DE DADOS
# ========================================

# PostgreSQL (RECOMENDADO para produção)
POSTGRES_AUTH_DB=postgresql://postgres:postgres@postgres:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:postgres@postgres:5432/evogo_users?sslmode=disable

# Salvar mensagens no banco de dados
DATABASE_SAVE_MESSAGES=false

# ========================================
# LOGS E DEBUG
# ========================================

# Ligar logs de debug (1 = ligado, 0 = desligado)
DEBUG_ENABLED=0

# Tipo de log (console, file)
LOG_TYPE=console

# Diretório de logs
LOG_DIRECTORY=/app/data/logs

# Tamanho máximo do arquivo de log em MB
LOG_MAX_SIZE=100

# Número máximo de arquivos de backup
LOG_MAX_BACKUPS=5

# Dias de retenção dos logs
LOG_MAX_AGE=30

# Comprimir logs antigos
LOG_COMPRESS=true

# ========================================
# CONEXÃO
# ========================================

# Conectar automaticamente ao iniciar
CONNECT_ON_STARTUP=false

# Enviar arquivos via webhook
WEBHOOK_FILES=true

# Nome do sistema operacional
OS_NAME=Linux

# ========================================
# EVENTOS E WEBHOOKS
# ========================================

# URL do webhook para receber eventos
WEBHOOK_URL=

# --- Assinatura HMAC do webhook -----------------------------------------------
# Cada entrega HTTP pode ser assinada com HMAC-SHA256 do corpo exato, no header
# "x-hmac-signature". O consumidor verifica antes de confiar no payload.
#
# WEBHOOK_HMAC_KEY assina as entregas das instancias sem chave propria. Chaves
# por instancia sao configuradas em runtime via POST /instance/hmac (header
# "apikey: <token da instancia>") e tem prioridade sobre esta.
# WEBHOOK_HMAC_KEY=
#
# Chaves por instancia sao cifradas em repouso com WEBHOOK_HMAC_ENCRYPTION_KEY.
# Se ela nao for definida, usa GLOBAL_ENCRYPTION_KEY; se nenhuma existir, deriva
# de GLOBAL_API_KEY. Defina explicitamente (e mantenha estavel) para rotacionar
# GLOBAL_API_KEY sem invalidar as chaves salvas.
# WEBHOOK_HMAC_ENCRYPTION_KEY=
# GLOBAL_ENCRYPTION_KEY=

# --- Fila dead-letter de webhooks ---------------------------------------------
# Webhooks que falham permanentemente (todas as tentativas esgotadas, ou resposta
# nao-retentavel) sao publicados nesta fila do RabbitMQ para inspecao/replay.
# So vale quando AMQP_URL esta definido; sem RabbitMQ a falha e apenas logada.
# Padrao: webhook_errors
# WEBHOOK_ERROR_QUEUE_NAME=webhook_errors

# --- Protecao SSRF ------------------------------------------------------------
# Downloads de URLs fornecidas pelo chamador (midia por URL, preview de link,
# stickers, avatares, foto de grupo, cabecalhos de botao/carrossel) podem
# recusar conexoes para loopback, redes privadas, link-local (metadata de nuvem)
# e multicast. Isto e OPT-IN por enquanto: defina true apenas quando toda a
# midia vier de hosts publicos. O padrao (false) mantem hosts internos
# (MinIO self-hosted, Typebot, CDN interno) funcionando.
SSRF_PROTECTION=false


# RabbitMQ
AMQP_URL=
AMQP_GLOBAL_ENABLED=false
AMQP_GLOBAL_EVENTS=
AMQP_SPECIFIC_EVENTS=

# NATS
NATS_URL=
NATS_GLOBAL_ENABLED=false
NATS_GLOBAL_EVENTS=

# Ignorar eventos de grupos
EVENT_IGNORE_GROUP=false

# Ignorar eventos de status
EVENT_IGNORE_STATUS=true

# ========================================
# ARMAZENAMENTO DE MÍDIA (MinIO/S3)
# ========================================

MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_REGION=

# ========================================
# PROXY (Opcional)
# ========================================

PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ========================================
# RECURSOS ADICIONAIS
# ========================================

# API de conversão de áudio
API_AUDIO_CONVERTER=
API_AUDIO_CONVERTER_KEY=

# Número máximo de tentativas de QR Code
QRCODE_MAX_COUNT=5

# Verificar se o usuário existe antes de enviar mensagem
CHECK_USER_EXISTS=true

# Versão do WhatsApp (opcional - deixe vazio para usar a padrão)
WHATSAPP_VERSION_MAJOR=
WHATSAPP_VERSION_MINOR=
WHATSAPP_VERSION_PATCH=
