# WaMux - Configuração opcional
#
# Nada aqui é obrigatório: o docker-compose.yml sobe sem este arquivo. Para mudar algo,
# copie para .env e descomente só o que precisar. Os valores mostrados são os padrões.

# ========================================
# COMPOSE
# ========================================

# Porta no host onde a API/Manager ficam expostos (a app escuta 8080 dentro).
# WAMUX_PORT=8081

# Tag da imagem: `dev` (branch develop), `1.0.0` (release) ou `latest`.
# WAMUX_VERSION=latest

# ========================================
# ACESSO
# ========================================

# Chave de administrador. Sem ela, uma é gerada no primeiro boot e salva no volume:
#   docker compose exec wamux cat /app/data/global-api-key
# GLOBAL_API_KEY=

# Senha do Postgres do compose. Defina antes do primeiro boot: depois disso o banco
# já existe com a senha antiga. O Postgres não é publicado fora do Docker.
# POSTGRES_PASSWORD=wamux_pass

# Nome deste servidor. As instâncias pertencem ao nome com que foram criadas: ao
# trocá-lo, elas somem do manager e não reconectam até voltar ao nome antigo. Nada é
# apagado. Servidores que compartilham um banco precisam de nomes diferentes.
CLIENT_NAME=wamux

# Proxies que podem informar o IP do cliente (X-Forwarded-For). Por padrão, endereços
# privados: proxy no mesmo host, rede Docker ou LAN funcionam sem configurar nada.
# Liste os IPs/CIDRs de um proxy em endereço público, ou use `none` para ignorar o header.
# TRUSTED_PROXIES=

# ========================================
# BANCO DE DADOS
# ========================================

# Salvar mensagens no banco de dados
# DATABASE_SAVE_MESSAGES=true

# Salvar o histórico enviado pelo celular, até o limite de MESSAGE_RETENTION_DAYS
# DATABASE_SAVE_HISTORY_SYNC=true

# Dias que as mensagens ficam guardadas (0 = para sempre)
# MESSAGE_RETENTION_DAYS=365

# Profundidade do histórico pedido ao celular no pareamento
# HISTORY_SYNC_DAYS=3650
# HISTORY_SYNC_MAX_MB=10240
# HISTORY_STORAGE_QUOTA_MB=10240

# Fechamentos 440 consecutivos antes de bloquear a reconexão automática
# RECONNECT_CONFLICT_LIMIT=10

# Watchdog de socket: off | report | on
# WATCHDOG_MODE=report
# WATCHDOG_MAX_REBUILDS=5

# Remover o cliente em memória após N minutos desconectado (0 = desligado)
# INSTANCE_IDLE_EVICT_MINUTES=0

# Retenção de tabelas auxiliares (0 mantém para sempre)
# SEND_OPERATION_RETENTION_DAYS=30
# CHAT_READ_RETENTION_DAYS=0
# CHAT_STATE_RETENTION_DAYS=0
# TYPEBOT_SESSION_RETENTION_DAYS=0
# POLL_VOTE_RETENTION_DAYS=0

# ========================================
# LOGS E DEBUG
# ========================================

# Ligar logs de debug (1 = ligado, 0 = desligado)
# DEBUG_ENABLED=0

# Tipo de log (console, file)
# LOG_TYPE=console

# Diretório de logs
# LOG_DIRECTORY=/app/data/logs

# Tamanho máximo do arquivo de log em MB
# LOG_MAX_SIZE=100

# Número máximo de arquivos de backup
# LOG_MAX_BACKUPS=5

# Dias de retenção dos logs
# LOG_MAX_AGE=30

# Comprimir logs antigos
# LOG_COMPRESS=true

# ========================================
# CONEXÃO
# ========================================

# Conectar automaticamente ao iniciar
# CONNECT_ON_STARTUP=true

# Enviar arquivos via webhook
# WEBHOOK_FILES=true

# Incluir o token da instância nos payloads de eventos (compatibilidade)
# WEBHOOK_INCLUDE_TOKEN=true

# Nome do sistema operacional
# OS_NAME=WaMux

# ========================================
# EVENTOS E WEBHOOKS
# ========================================

# URL do webhook para receber eventos
# WEBHOOK_URL=

# --- Assinatura HMAC do webhook -----------------------------------------------
# Cada entrega HTTP pode ser assinada com HMAC-SHA256 do corpo exato, no header
# "x-hmac-signature". O consumidor verifica antes de confiar no payload.
#
# WEBHOOK_HMAC_KEY assina as entregas das instancias sem chave propria. Chaves
# por instancia sao configuradas em runtime via POST /instance/hmac (header
# "apikey: <token da instancia>") e tem prioridade sobre esta.
# WEBHOOK_HMAC_KEY=
#
# Chaves por instancia sao cifradas em repouso com WEBHOOK_HMAC_ENCRYPTION_KEY.
# Se ela nao for definida, usa GLOBAL_ENCRYPTION_KEY; se nenhuma existir, deriva
# de GLOBAL_API_KEY. Defina explicitamente (e mantenha estavel) para rotacionar
# GLOBAL_API_KEY sem invalidar as chaves salvas.
# WEBHOOK_HMAC_ENCRYPTION_KEY=
# GLOBAL_ENCRYPTION_KEY=

# --- Fila dead-letter de webhooks ---------------------------------------------
# Webhooks que falham permanentemente (todas as tentativas esgotadas, ou resposta
# nao-retentavel) sao publicados nesta fila do RabbitMQ para inspecao/replay.
# So vale quando AMQP_URL esta definido; sem RabbitMQ a falha e apenas logada.
# Padrao: webhook_errors
# WEBHOOK_ERROR_QUEUE_NAME=webhook_errors

# --- Protecao SSRF ------------------------------------------------------------
# Downloads de URLs fornecidas pelo chamador (midia por URL, preview de link,
# stickers, avatares, foto de grupo, cabecalhos de botao/carrossel) podem
# recusar conexoes para loopback, redes privadas, link-local (metadata de nuvem)
# e multicast. Isto e OPT-IN por enquanto: defina true apenas quando toda a
# midia vier de hosts publicos. O padrao (false) mantem hosts internos
# (MinIO self-hosted, Typebot, CDN interno) funcionando.
# SSRF_PROTECTION=false


# RabbitMQ
# AMQP_URL=
# AMQP_GLOBAL_ENABLED=false
# AMQP_GLOBAL_EVENTS=
# AMQP_SPECIFIC_EVENTS=

# NATS
# NATS_URL=
# NATS_GLOBAL_ENABLED=false
# NATS_GLOBAL_EVENTS=

# Ignorar eventos de grupos
# EVENT_IGNORE_GROUP=false

# Ignorar eventos de status
# EVENT_IGNORE_STATUS=false

# ========================================
# ARMAZENAMENTO DE MÍDIA (MinIO/S3)
# ========================================

# MINIO_ENABLED=false
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# MINIO_USE_SSL=false
# MINIO_REGION=
# S3_PUBLIC_READ=false
# Permitir que webhooks/Typebot/S3 por instância alcancem hosts privados
# INTEGRATIONS_ALLOW_PRIVATE=false

# ========================================
# PROXY (Opcional)
# ========================================

# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ========================================
# RECURSOS ADICIONAIS
# ========================================

# API de conversão de áudio
# API_AUDIO_CONVERTER=
# API_AUDIO_CONVERTER_KEY=

# Número máximo de tentativas de QR Code
# QRCODE_MAX_COUNT=5

# Verificar se o usuário existe antes de enviar mensagem
# CHECK_USER_EXISTS=true

# Versão do WhatsApp (opcional - deixe vazio para usar a padrão)
# WHATSAPP_VERSION_MAJOR=
# WHATSAPP_VERSION_MINOR=
# WHATSAPP_VERSION_PATCH=
