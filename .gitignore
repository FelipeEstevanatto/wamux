.env
logs/*
build/
*.prof
coverage.*
.air.toml
.idea/
.vscode/
.DS_Store

# Locally-compiled server binary that upstream accidentally committed at the
# repo root (64MB ELF). It is a build artifact, never needed in git; the
# Dockerfile compiles its own. Anchored so it does not hide a directory.
/evolution-go
/wamux

# Manager SPA build output. Vite emits content-hashed filenames, so committing
# these adds a new blob to git history on every build. They are regenerated by
# `make manager-build` (local runs) and by the Dockerfile's manager stage, so
# they are not tracked. `manager/dist/dashboard.html` is fork-only hand-written
# and stays tracked.
/manager/dist/assets/
/manager/dist/index.html
