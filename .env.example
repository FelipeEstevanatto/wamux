SERVER_PORT=8080

POSTGRES_AUTH_DB=postgresql://postgres:root@localhost:5432/wamux_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:root@localhost:5432/wamux_users?sslmode=disable
DATABASE_SAVE_MESSAGES=false
CLIENT_NAME=wamux

# How long (seconds) the dashboard may serve /server/stats and the per-instance
# message/chat counts from memory. This only applies when the message_counters
# rollup is unavailable and the dashboard has to aggregate the whole messages
# table; with the rollup installed the numbers are always fresh. 0 disables the
# cache. Default: 30.
# DASHBOARD_CACHE_TTL_SECONDS=30

# How long persisted messages are kept. A background job deletes anything older,
# in batches, every 6 hours; 0 keeps messages forever. Default: 365 (1 year).
# MESSAGE_RETENTION_DAYS=365

GLOBAL_API_KEY=change-me

# NOTE (fork): license activation and telemetry have been removed.
# No WAMUX_OPERATOR_EMAIL, no /license/* endpoints, no heartbeats.

WADEBUG=DEBUG
LOGTYPE=console

# Download inbound attachments so they can be forwarded with the webhook.
# Defaults to false: media is not written to disk.
WEBHOOK_FILES=false

# Keep a copy of incoming/outgoing attachments under <dataDir>/media so the
# manager can preview them without MinIO/S3. Defaults to false. Enable it
# together with DATABASE_SAVE_MESSAGES=true to preview files in the manager.
MEDIA_LOCAL_STORE=false

CONNECT_ON_STARTUP=true

OS_NAME=WaMux

# Swagger UI at /swagger/index.html. Public (not protected by GLOBAL_API_KEY),
# so anyone who can reach the port can read the API surface. Set false to
# disable the routes. Defaults to true when unset.
SWAGGER_ENABLED=true

# Passkey (WebAuthn) pairing — required only for accounts that ask for a passkey
# when linking a device. Set this to the PUBLIC base URL of THIS API, reachable
# by the browser where WhatsApp Web opens (the WaMux Passkey Helper extension
# calls it from the web.whatsapp.com origin). Use a public domain in production,
# or a tunnel (ngrok/cloudflared) / LAN IP in development — NOT localhost if the
# browser runs on another machine. See docs/wiki/guias-api/passkey-pairing.md.
# PASSKEY_PUBLIC_URL=https://your-api.example.com

AMQP_URL=amqp://admin:admin@localhost:5672/default
AMQP_GLOBAL_ENABLED=false

WEBHOOK_URL=https://webhook.site/2e6af2fa-6b04-497f-b4a1-13a905728d83

# --- Webhook HMAC signing -----------------------------------------------------
# Every HTTP webhook delivery can be signed with an HMAC-SHA256 of the exact
# body, sent in the "x-hmac-signature" header. Consumers verify it before
# trusting the payload.
#
# WEBHOOK_HMAC_KEY signs deliveries for instances that have no per-instance
# key. Per-instance keys are configured at runtime via POST /instance/hmac
# (header "apikey: <instance token>") and take precedence over this one.
# WEBHOOK_HMAC_KEY=
#
# Per-instance keys are encrypted at rest with WEBHOOK_HMAC_ENCRYPTION_KEY.
# When it is unset, GLOBAL_ENCRYPTION_KEY is used; when that is also unset, a
# key is derived from GLOBAL_API_KEY. Set this explicitly (and keep it stable)
# if you want rotating GLOBAL_API_KEY not to invalidate stored keys.
# WEBHOOK_HMAC_ENCRYPTION_KEY=
# GLOBAL_ENCRYPTION_KEY=

# --- Webhook dead-letter queue -------------------------------------------------
# Webhooks that fail permanently (all retries exhausted, or a non-retryable
# response) are published to this RabbitMQ queue for inspection/replay. It only
# applies when AMQP_URL is set; without RabbitMQ the failure is only logged.
# Default: webhook_errors
# WEBHOOK_ERROR_QUEUE_NAME=webhook_errors

# --- SSRF protection ----------------------------------------------------------
# Outbound fetches of caller-supplied URLs (media by URL, link previews,
# stickers, avatars, group photos, button/carousel headers) can refuse to
# connect to loopback, private, link-local (cloud metadata) and multicast
# addresses. This is OPT-IN for now: set to true only when all media comes from
# public hosts. The default (false) keeps internal hosts (self-hosted MinIO,
# Typebot, internal CDN) working.
SSRF_PROTECTION=false

# HTTP abuse protection. Rate limit is per credential (instance token / admin
# key), or per client IP when unauthenticated. 0 disables it.
RATE_LIMIT_PER_MINUTE=600

# CORS origin allowlist, comma-separated. Empty means same-origin only (the
# manager is served from the same origin, so it works with no config). Use "*"
# to reflect any origin (credentials are then NOT allowed, which is the correct
# behaviour). Supports exact origins and host wildcards:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://*.example.com
CORS_ALLOWED_ORIGINS=

# gzip responses (JSON API + the manager SPA/assets) when the client accepts it.
# On by default. A reverse proxy will not re-encode a body that is already gzip
# (the client is fine either way), but compressing in BOTH places pays the CPU
# twice — so decide who compresses: set this to false when the proxy in front
# (nginx/Traefik/Cloudflare) already gzips, or turn the proxy's gzip off.
HTTP_COMPRESSION=true

# --- Per-tenant resource limits ---------------------------------------------
# Cap how many instances this deployment accepts (0 = unlimited). Each instance
# costs a WhatsApp socket and memory, so set this to your node's ceiling.
MAX_INSTANCES=0
# Bound POST /send/* per instance token (requests/minute; 0 = unlimited) and
# in-flight sends per instance (0 = unlimited). Stops one tenant starving the
# shared persistence pool / workers.
SEND_RATE_LIMIT_PER_MINUTE=0
SEND_MAX_CONCURRENT=0

# --- Horizontal scaling / failover ------------------------------------------
# NODE_ID identifies this process in the instance_ownership table (defaults to
# the hostname; distinct per node). A single node needs no config. OWNERSHIP_
# LEASE_TTL_SECONDS is how long a node's claim survives without a heartbeat
# before another healthy node may adopt its instances.
# NODE_ID=node-1
OWNERSHIP_LEASE_TTL_SECONDS=60

# --- Database pool budget (multi-node) --------------------------------------
# This process opens THREE Postgres pools (auth, users, whatsmeow key store), so
# N nodes ask for 75*N connections. Set these to keep a cluster within Postgres
# max_connections: the per-node budget is divided by the node count and split
# across the three pools. Unset/0 keeps the historical DB_MAX_OPEN_CONNS.
DB_POOL_BUDGET_PER_NODE=0
DB_NODE_COUNT=1

# --- Benchmarking -----------------------------------------------------------
# Expose /debug/pprof (CPU/heap profiles). Requires the admin key; keep off in
# production.
PPROF_ENABLED=false


# Proxy Configuration
# PROXY_PROTOCOL can be http, https or socks5. If omitted, it is inferred from
# the port (1080/2080/42000-43000 → socks5; otherwise http).
# PROXY_PROTOCOL=http
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=secret

# Minio Configuration
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wamux-media
MINIO_USE_SSL=false