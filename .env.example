SERVER_PORT=8080

POSTGRES_AUTH_DB=postgresql://postgres:root@localhost:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:root@localhost:5432/evogo_users?sslmode=disable
DATABASE_SAVE_MESSAGES=false
CLIENT_NAME=evolution

# How long (seconds) the dashboard may serve /server/stats and the per-instance
# message/chat counts from memory. This only applies when the message_counters
# rollup is unavailable and the dashboard has to aggregate the whole messages
# table; with the rollup installed the numbers are always fresh. 0 disables the
# cache. Default: 30.
# DASHBOARD_CACHE_TTL_SECONDS=30

# How long persisted messages are kept. A background job deletes anything older,
# in batches, every 6 hours; 0 keeps messages forever. Default: 365 (1 year).
# MESSAGE_RETENTION_DAYS=365

GLOBAL_API_KEY=REMOVED-SECRET

# NOTE (fork): license activation and telemetry have been removed.
# No EVOLUTION_OPERATOR_EMAIL, no /license/* endpoints, no heartbeats.

WADEBUG=DEBUG
LOGTYPE=console
WEBHOOK_FILES=true

CONNECT_ON_STARTUP=true

OS_NAME=Evolution GO

# Swagger UI at /swagger/index.html. Public (not protected by GLOBAL_API_KEY),
# so anyone who can reach the port can read the API surface. Set false to
# disable the routes. Defaults to true when unset.
SWAGGER_ENABLED=true

# Passkey (WebAuthn) pairing — required only for accounts that ask for a passkey
# when linking a device. Set this to the PUBLIC base URL of THIS API, reachable
# by the browser where WhatsApp Web opens (the Evolution Passkey Helper extension
# calls it from the web.whatsapp.com origin). Use a public domain in production,
# or a tunnel (ngrok/cloudflared) / LAN IP in development — NOT localhost if the
# browser runs on another machine. See docs/wiki/guias-api/passkey-pairing.md.
# PASSKEY_PUBLIC_URL=https://your-api.example.com

AMQP_URL=amqp://admin:admin@localhost:5672/default
AMQP_GLOBAL_ENABLED=false

WEBHOOK_URL=https://webhook.site/2e6af2fa-6b04-497f-b4a1-13a905728d83

# Proxy Configuration
# PROXY_PROTOCOL can be http, https or socks5. If omitted, it is inferred from
# the port (1080/2080/42000-43000 → socks5; otherwise http).
# PROXY_PROTOCOL=http
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=secret

# Minio Configuration
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evolution-media
MINIO_USE_SSL=false